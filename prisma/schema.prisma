generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum CategoryType {
  CSR_ACTIVITY
  CHALLENGE
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  MISSED
  ACHIEVED
}

enum ActivityStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AuditStatus {
  PLANNED
  IN_PROGRESS
  CLOSED
}

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  OVERDUE
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  COMPLETED
  ARCHIVED
}

enum ChallengeParticipationStatus {
  JOINED
  SUBMITTED
  APPROVED
  REJECTED
}

enum RewardStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum NotificationType {
  PARTICIPATION_APPROVED
  PARTICIPATION_REJECTED
  CHALLENGE_APPROVED
  BADGE_UNLOCKED
  POLICY_REMINDER
  COMPLIANCE_OVERDUE
  CSR_ACTIVITY_CREATED
  CHALLENGE_CREATED
  POLICY_CREATED
  COMPLIANCE_ISSUE_ASSIGNED
  REWARD_REDEEMED
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  password     String
  role         Role    @default(EMPLOYEE)
  departmentId String?
  totalXP      Int     @default(0)
  totalPoints  Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department              Department?               @relation("DeptMembers", fields: [departmentId], references: [id])
  ledDepartments          Department[]              @relation("DeptHead")
  carbonTransactions      CarbonTransaction[]
  csrParticipations       EmployeeParticipation[]
  csrActivitiesCreated    CSRActivity[]
  policyAcknowledgements  PolicyAcknowledgement[]
  policiesCreated         ESGPolicy[]
  auditsConducted         Audit[]
  complianceIssuesOwned   ComplianceIssue[]         @relation("IssueOwner")
  challengesCreated       Challenge[]
  challengeParticipations ChallengeParticipation[]
  userBadges              UserBadge[]
  rewardRedemptions       RewardRedemption[]
  notifications           Notification[]

  @@index([departmentId])
  @@index([role])
}

model Department {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  headId      String?
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  head                User?               @relation("DeptHead", fields: [headId], references: [id])
  members             User[]              @relation("DeptMembers")
  carbonTransactions  CarbonTransaction[]
  environmentalGoals  EnvironmentalGoal[]
  departmentScores    DepartmentScore[]
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  status    Boolean      @default(true)
  createdAt DateTime     @default(now())

  csrActivities CSRActivity[]
  challenges    Challenge[]
}

model EmissionFactor {
  id        String   @id @default(cuid())
  name      String
  factor    Float
  unit      String
  scope     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  carbonTransactions CarbonTransaction[]
}

model CarbonTransaction {
  id               String   @id @default(cuid())
  source           String
  amount           Float
  unit             String
  totalEmissions   Float
  notes            String?
  date             DateTime
  createdAt        DateTime @default(now())

  emissionFactorId String
  emissionFactor   EmissionFactor @relation(fields: [emissionFactorId], references: [id])
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])

  @@index([departmentId, date])
}

model EnvironmentalGoal {
  id           String     @id @default(cuid())
  title        String
  description  String?
  targetKg     Float
  currentKg    Float      @default(0)
  unit         String     @default("kg CO2")
  deadline     DateTime
  status       GoalStatus @default(ON_TRACK)
  departmentId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
}

model CSRActivity {
  id              String         @id @default(cuid())
  title           String
  description     String
  categoryId      String
  points          Int            @default(10)
  maxParticipants Int?
  startDate       DateTime
  endDate         DateTime
  status          ActivityStatus @default(UPCOMING)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category       Category                @relation(fields: [categoryId], references: [id])
  createdBy      User                    @relation(fields: [createdById], references: [id])
  participations EmployeeParticipation[]
}

model EmployeeParticipation {
  id             String              @id @default(cuid())
  userId         String
  activityId     String
  proofUrl       String?
  status         ParticipationStatus @default(PENDING)
  pointsEarned   Int                 @default(0)
  completionDate DateTime?
  reviewNote     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  activity CSRActivity @relation(fields: [activityId], references: [id])

  @@unique([userId, activityId])
}

model ESGPolicy {
  id            String       @id @default(cuid())
  title         String
  description   String
  effectiveDate DateTime
  status        PolicyStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy       User                    @relation(fields: [createdById], references: [id])
  acknowledgements PolicyAcknowledgement[]
}

model PolicyAcknowledgement {
  id             String   @id @default(cuid())
  policyId       String
  userId         String
  acknowledgedAt DateTime @default(now())

  policy ESGPolicy @relation(fields: [policyId], references: [id])
  user   User      @relation(fields: [userId], references: [id])

  @@unique([policyId, userId])
}

model Audit {
  id          String      @id @default(cuid())
  title       String
  scope       String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      AuditStatus @default(PLANNED)
  auditorId   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  auditor          User              @relation(fields: [auditorId], references: [id])
  complianceIssues ComplianceIssue[]
}

model ComplianceIssue {
  id          String        @id @default(cuid())
  auditId     String
  title       String
  description String
  severity    IssueSeverity @default(MEDIUM)
  ownerId     String
  dueDate     DateTime
  status      IssueStatus   @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  audit Audit @relation(fields: [auditId], references: [id])
  owner User  @relation("IssueOwner", fields: [ownerId], references: [id])

  @@index([status, dueDate])
}

model Challenge {
  id               String          @id @default(cuid())
  title            String
  description      String
  categoryId       String
  xpReward         Int
  difficulty       String
  evidenceRequired Boolean         @default(true)
  deadline         DateTime
  status           ChallengeStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  category       Category                 @relation(fields: [categoryId], references: [id])
  createdBy      User                     @relation(fields: [createdById], references: [id])
  participations ChallengeParticipation[]
}

model ChallengeParticipation {
  id          String                       @id @default(cuid())
  challengeId String
  userId      String
  proofUrl    String?
  progress    Int                          @default(0)
  status      ChallengeParticipationStatus @default(JOINED)
  xpAwarded   Int                          @default(0)
  reviewNote  String?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([challengeId, userId])
}

model Badge {
  id              String @id @default(cuid())
  name            String @unique
  description     String
  iconEmoji       String @default("🏅")
  unlockType      String
  unlockThreshold Int
  createdAt       DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Reward {
  id             String       @id @default(cuid())
  name           String
  description    String
  pointsRequired Int
  stock          Int
  status         RewardStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id             String   @id @default(cuid())
  userId         String
  rewardId       String
  pointsDeducted Int
  redeemedAt     DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])
}

model DepartmentScore {
  id                 String   @id @default(cuid())
  departmentId       String
  environmentalScore Float
  socialScore        Float
  governanceScore    Float
  totalScore         Float
  periodStart        DateTime
  periodEnd          DateTime
  calculatedAt       DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId, periodStart])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}
